#!/usr/bin/env sh

echo "======================================================="
echo "🛡️ RUNNING PRE-COMMIT CHECKS (Lint, Typecheck, Tests)"
echo "======================================================="

# Run TypeScript checking
echo "\n⏳ 1. Checking TypeScript Types (tsc)..."
pnpm run lint || {
  echo ""
  echo "    🤖 BEEP BOOP! ERROR DETECTED! 🤖"
  echo "    /-----------------------------\\"
  echo "    | TYPECHECK FAILED!           |"
  echo "    | Please fix TS errors.       |"
  echo "    \\-----------------------------/"
  echo "           \\   ^__^"
  echo "            \\  (xx)\\_______"
  echo "               (__)\\       )\\/\\"
  echo "                U  ||----w |"
  echo "                   ||     ||"
  echo ""
  exit 1
}

# Run Unit Tests WITH Coverage Threshold
echo "\n⏳ 2. Running Unit Tests & Coverage Verification (Vitest)..."
pnpm run coverage || {
  echo ""
  echo "    🤖 BEEP BOOP! ERROR DETECTED! 🤖"
  echo "    /-----------------------------\\"
  echo "    | UNIT TESTS / COVERAGE FAIL! |"
  echo "    | Please fix broken tests.    |"
  echo "    \\-----------------------------/"
  echo "           \\   ^__^"
  echo "            \\  (xx)\\_______"
  echo "               (__)\\       )\\/\\"
  echo "                U  ||----w |"
  echo "                   ||     ||"
  echo ""
  exit 1
}

echo "\n✅ ALL CHECKS PASSED! Code is bulletproof! Proceeding with commit..."
echo "=======================================================\n"
